<configuration>

  <system.web>
    <compilation debug="true"/>
  </system.web>
  <!-- When deploying the service library project, the content of the config file must be added to the host's 
  app.config file. System.Configuration does not support config files for libraries. -->
  <system.serviceModel>
    <client>
      <endpoint address="net.tcp://localhost:8739/Fanex.Workbook.Service/WorkbookService/"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IWorkbookService"
        contract="WorkbookService.IWorkbookService" name="NetTcpBinding_IWorkbookService">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8739/Fanex.Workbook.Service/WorkbookService/"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IWorkbookService1"
        contract="ServiceReference1.IWorkbookService" name="NetTcpBinding_IWorkbookService1">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
    </client>
    <services>
      <service name="Fanex.Workbook.Service.WorkbookService">
        <endpoint address="" behaviorConfiguration="TcpEndpointBehaviour"
          binding="netTcpBinding" bindingConfiguration="netTcpEndpoint"
          contract="Fanex.Workbook.Service.IWorkbookService">
          <identity>
            <dns value="10.18.200.202" />
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://10.18.200.202:8739/Fanex.Workbook.Service/WorkbookService/" />
          </baseAddresses>
        </host>
      </service>
    </services>


    <behaviors>

      <endpointBehaviors>

        <behavior name="TcpEndpointBehaviour">

          <dataContractSerializer maxItemsInObjectGraph="2147483647" />

        </behavior>

      </endpointBehaviors>


      <serviceBehaviors>
        <behavior name="">
          <serviceMetadata httpGetEnabled="false"/>
          <serviceDebug includeExceptionDetailInFaults="false"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>


    <bindings>
      <netTcpBinding>
        <binding name="netTcpEndpoint" closeTimeout="00:01:00" openTimeout="00:01:00"
          receiveTimeout="00:10:00" sendTimeout="00:10:00" transactionFlow="false"
          transferMode="Buffered" maxBufferPoolSize="2147483647" maxBufferSize="2147483647"
          maxReceivedMessageSize="2147483647">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647"
            maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
        </binding>
        <binding name="NetTcpBinding_IWorkbookService" closeTimeout="00:01:00"
          openTimeout="00:01:00" receiveTimeout="00:10:00" sendTimeout="00:01:00"
          transactionFlow="false" transferMode="Buffered" transactionProtocol="OleTransactions"
          hostNameComparisonMode="StrongWildcard" listenBacklog="10" maxBufferPoolSize="524288"
          maxBufferSize="65536" maxConnections="10" maxReceivedMessageSize="65536">
          <readerQuotas maxDepth="32" maxStringContentLength="8192" maxArrayLength="16384"
            maxBytesPerRead="4096" maxNameTableCharCount="16384" />
          <reliableSession ordered="true" inactivityTimeout="00:10:00"
            enabled="false" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
            <message clientCredentialType="Windows" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IWorkbookService1" />
      </netTcpBinding>
    </bindings>


  </system.serviceModel>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
</configuration>
